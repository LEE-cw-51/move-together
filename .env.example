# App (Expo). Use the machine LAN address when testing on a phone.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Backend
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
PORT=8787
NODE_ENV=development
PUBLIC_API_URL=http://localhost:8787
APP_SCHEME=movetogether

# Magic link email. If RESEND_API_KEY is unset, development logs the link
# and the API returns devToken. Production never returns the link.
RESEND_API_KEY=
EMAIL_FROM=Move Together <noreply@example.com>
MAGIC_LINK_TTL_MINUTES=15
SESSION_TTL_DAYS=30
INVITE_TTL_DAYS=7

# Object storage. All four are required to use S3/R2/Neon Object Storage.
# If any are missing, files are stored in LOCAL_STORAGE_DIR and served at /dev-media.
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_BASE_URL=
LOCAL_STORAGE_DIR=

# Push. Notification rows are always written. Expo push is attempted when a token exists.
EXPO_ACCESS_TOKEN=

# Protects POST /internal/jobs/evening-reminders. Unset means the endpoint returns 503.
CRON_SECRET=
