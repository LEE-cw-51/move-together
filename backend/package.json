{
  "name": "@move-together/backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "start": "tsx --env-file=../.env src/index.ts",
    "migrate": "tsx --env-file=../.env src/migrate.ts",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@hono/node-server": "^1.19.0",
    "@move-together/shared": "*",
    "hono": "^4.9.8",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.11",
    "@types/node": "^22.17.2",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.5",
    "typescript": "~5.9.2"
  }
}
